{
  "name": "aegis-intel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "archiver": "7.0.1",
    "cheerio": "1.1.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "https-proxy-agent": "7.0.6",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "vite": "8.3.2"
  }
}
